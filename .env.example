# Copy to .env next to your docker-compose file and fill in.
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Optional overrides (defaults shown):
# DATABASE=asset_tracker
# DB_USERNAME=conspectus
# TZ=UTC   # calendar time zone for month bucketing and date display

# Optional: gate the whole app behind HTTP basic auth (or bearer tokens).
# Hash a password with: printf '%s' 'password' | sha256sum
# CONSPECTUS_BASICAUTH_USERS=alice:5e884898da28047151d0e56f8dc6292773603d0d6aabbdd62a11ef721d1542d8

# Optional: show a banner strip on every page. {{version}}, {{hostname}} and
# {{date}} are substituted (spaces inside the braces allowed, e.g. {{ version }}).
# Unset (or empty) = no banner.
# CONSPECTUS_BANNER_TEXT=Read-only viewer · v{{version}}

# Run an API-only server (no HTML pages): the JSON API under /api/v1 plus
# /healthz stays reachable; every page path 404s.
# CONSPECTUS_WEB=false

# Split deployment: run this process as PAGES-ONLY frontend against a
# remote API server. Needs no database (leave the CONSPECTUS_MYSQL_* and
# DB_* variables unset); all data is fetched over HTTP. Pair with
# CONSPECTUS_WEB=false on the other process to get a pure API server.
# CONSPECTUS_API_URL=http://api-host:8080
